# SignalWire credentials (same values as the repo root .env)
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_TOKEN=
# Space hostname, no scheme: example.signalwire.com
SIGNALWIRE_SPACE_URL=

# Public base URL of the Cloudflare tunnel, no trailing slash.
# Used for connect status_url callbacks and the request-flow auth URL.
PUBLIC_URL=

# The child's device (the B-leg every allowed call bridges to)
KIDDYPHONE_ENDPOINT_SIP_URI=sip:child@example.sip.signalwire.com

# A SIP endpoint that is never registered, so it rings forever.
# The two-step flow parks the caller against it while the check runs.
KIDDYPHONE_DEAD_SIP_URI=sip:deadendpoint@example.sip.signalwire.com

# Whitelist. PSTN entries are comma-separated, any common format.
# SIP entries are comma-separated user@host pairs; user AND host must match.
WHITELIST_PSTN=+15551234567
WHITELIST_SIP=parent@example.sip.signalwire.com
KIDDYPHONE_DEFAULT_REGION=US

PORT=8080

# U4 probe: artificial delay in ms before /inbound responds. Raise it stepwise
# (0, 2000, 5000, 10000, ...) to find where the platform gives up on the webhook.
DELAY_MS=0

# Simulated authorization check time (KiddyPhone's real check is ~1500ms).
# Used by the two-step flow and the /auth endpoint.
CHECK_DELAY_MS=1500

# Test-suite UI (/ui): the DID and SIP endpoint the arm buttons re-point.
PWPOC_DID_ID=
PWPOC_DID_NUMBER=
PWPOC_SIP_ENDPOINT_ID=
